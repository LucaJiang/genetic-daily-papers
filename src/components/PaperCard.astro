---
import type { CollectionEntry } from 'astro:content';
import PriorityBadge from './PriorityBadge.astro';
import { topicLabel } from '../data/topics';

interface Props {
  paper: CollectionEntry<'papers'>;
  featured?: boolean;
}

const { paper, featured = false } = Astro.props;
const date = paper.data.date.toISOString().slice(0, 10);
const figure = paper.data.figures[0] ?? paper.data.figure;
---
<article class:list={['paper-card', 'paper-card--v4', { 'paper-card--featured': featured }]}> 
  <div class="paper-card__layout">
    {figure && (
      <a class="paper-card__image" href={`/papers/${paper.id}/`} aria-label={`查看 ${paper.data.shortTitle ?? paper.data.title} 的详细解读`}>
        <span class="image-fallback">查看论文图</span>
        <img src={figure.url} alt={figure.alt} loading="lazy" decoding="async" />
      </a>
    )}
    <div class="paper-card__content">
      <div class="paper-card__topline">
        <PriorityBadge priority={paper.data.priority} />
        <span class="paper-card__meta">{paper.data.source} · {date}</span>
      </div>
      <h2 class="paper-card__title"><a href={`/papers/${paper.id}/`}>{paper.data.shortTitle ?? paper.data.title}</a></h2>
      <p class="paper-card__summary">{paper.data.summary}</p>
      {paper.data.keyResults.length > 0 && (
        <ul class="paper-card__results">
          {paper.data.keyResults.slice(0, 2).map((result) => <li>{result}</li>)}
        </ul>
      )}
      <div class="paper-card__footer">
        <div class="tag-list" aria-label="研究主题">
          {paper.data.topics.slice(0, 4).map((topic) => <a class="tag" href={`/topics/${topic}/`}>{topicLabel(topic)}</a>)}
        </div>
        <a class="text-link" href={`/papers/${paper.id}/`}>详细解读 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</article>
