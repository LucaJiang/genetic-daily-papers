---
import type {CollectionEntry} from 'astro:content';
import PriorityBadge from './PriorityBadge.astro';
import {topicLabel} from '../data/topics';
import {iso} from '../lib/issues';
interface Props{paper:CollectionEntry<'papers'>;index?:number;total?:number;featured?:boolean;}
const {paper,index=1}=Astro.props;
---
<article class="paper-card" data-paper-id={paper.id}>
<div class="paper-number" aria-hidden="true">{String(index).padStart(2,'0')}</div><div class="paper-card-main">
<div class="paper-meta"><span class="journal">{paper.data.source}</span><time datetime={iso(paper.data.date)}>{iso(paper.data.date)}</time><PriorityBadge priority={paper.data.priority}/></div>
<h2><a href={`/papers/${paper.id}/`}>{paper.data.shortTitle??paper.data.title}</a></h2><p class="card-summary">{paper.data.summary}</p>
{paper.data.keyResults[1]&&<p class="card-result"><span>结果</span>{paper.data.keyResults[1]}</p>}
<div class="card-bottom"><div class="tags">{paper.data.topics.slice(0,4).map(t=><a href={`/topics/${t}/`}>{topicLabel(t)}</a>)}</div><a class="read-link" href={`/papers/${paper.id}/`}>详细解读 <span aria-hidden="true">↗</span></a></div>
</div></article>
