---
import {
  figureAssetUrl,
  figureKindLabel,
  figureReference,
  figureTitle,
  type PaperFigure,
} from '../lib/figures';

interface Props {
  id: string;
  title: string;
  figures: PaperFigure[];
}

const { id, title, figures } = Astro.props;
---
{figures.length > 0 && (
  <section id={id} class="paper-figures" aria-labelledby={`${id}-title`}>
    <div class="article-section-title">
      <h2 id={`${id}-title`}>{title}</h2>
      <span>{figures.length} 张</span>
    </div>
    <div class="paper-figure-stack">
      {figures.map((figure, index) => {
        const localUrl = figureAssetUrl(figure.url);
        return (
          <figure class="paper-figure-v5">
            <a class="paper-figure-v5__image" href={figure.sourceUrl} target="_blank" rel="noreferrer">
              <span class="paper-figure-v5__fallback">图片未加载，打开原图 ↗</span>
              <img
                src={localUrl}
                data-fallback={figure.url}
                alt={figure.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
                onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;delete this.dataset.fallback}else{this.hidden=true;this.parentElement.classList.add('is-missing')}"
              />
            </a>
            <figcaption>
              <p class="figure-caption__meta">{figureReference(figure, index)} · {figureKindLabel(figure.kind)}</p>
              <h3>{figureTitle(figure, index)}</h3>
              <p>{figure.caption}</p>
              <small>{figure.credit}{figure.license ? ` · ${figure.license}` : ''} · <a href={figure.sourceUrl} target="_blank" rel="noreferrer">原图</a></small>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>
)}
