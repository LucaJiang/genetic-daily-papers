---
import {figureAssetUrl,figureKindLabel,figureReference,figureTitle,type PaperFigure} from '../lib/figures';
interface Props {id:string;title:string;figures:PaperFigure[];}
const {id,title,figures}=Astro.props;
---
{figures.length>0 && <section id={id} class="paper-article"><h2>{title}</h2>{figures.map((f,i)=><figure class="paper-figure"><a href={figureAssetUrl(f.url)} data-zoom><img src={figureAssetUrl(f.url)} alt={f.alt} loading="lazy"/></a><figcaption><span class="figure-label">{figureReference(f,i)} · {figureKindLabel(f.kind)}</span><strong>{figureTitle(f,i)}</strong><p>{f.caption}</p><small>{f.credit}{f.license?` · ${f.license}`:''} · <a href={f.sourceUrl} target="_blank" rel="noreferrer">原图与图注</a></small></figcaption></figure>)}</section>}
