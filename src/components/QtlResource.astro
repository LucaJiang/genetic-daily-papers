---
interface Props {
  resource: {
    id: string; name: string; version: string; tissue: string; qtlTypes: string[];
    summary: string; sampleSize: string; cellsPerDonor: string; assay: string;
    depth: string; access: string; limitations: string;
    sources: { label: string; url: string }[];
    fieldSources?: Partial<Record<string, number[]>>;
    group?: string;
    dataUrl?: string;
    ancestry: string;
    ancestryTags: string[];
    resourceTypes?: string[];
    detailSections?: {
      title: string;
      paragraphs?: string[];
      table?: { headers: string[]; rows: string[][] };
      sourceIndices?: number[];
      figure?: { src: string; alt: string; caption: string; width: number; height: number; sourceUrl: string };
    }[];
  };
}
const { resource: r } = Astro.props;
const fields = [
  ['sampleSize', '样本量 / donor', r.sampleSize],
  ['cellsPerDonor', '细胞数 / donor', r.cellsPerDonor],
  ['assay', '测序 / 测量方式', r.assay],
  ['depth', '测序深度', r.depth],
];
const dataSource = r.dataUrl ?? r.sources.find(s => /下载|数据入口|官方数据|汇总统计|门户|EGA|GEO/.test(s.label))?.url;
---
<article class="qtl-resource" id={r.id} aria-labelledby={`${r.id}-title`} data-ancestries={r.ancestryTags.join(' ')}>
  <header>
    <div class="qtl-meta"><span>{r.version}</span></div>
    <div class="qtl-title-row"><h3 id={`${r.id}-title`}><a href={`#${r.id}`}>{r.name}</a></h3>{dataSource && <a class="qtl-data-link" href={dataSource} target="_blank" rel="noreferrer">数据入口 ↗</a>}</div>
    <p class="qtl-tissue">{r.tissue}</p>
    <p class="qtl-ancestry"><strong>祖源</strong> {r.ancestry}<span class="qtl-cites">{(r.fieldSources?.ancestry ?? []).map(index => <a href={r.sources[index].url} target="_blank" rel="noreferrer" aria-label={`祖源来源：${r.sources[index].label}`}>[{index + 1}]</a>)}</span></p>
    <div class="qtl-types">{(r.resourceTypes ?? r.qtlTypes).map(type => <span>{type}</span>)}</div>
    <p class="qtl-summary">{r.summary}</p>
  </header>
  <dl class="qtl-fields">{fields.slice(0, 2).map(([key, label, value]) => <div><dt>{label}</dt><dd>{value}<span class="qtl-cites">{(r.fieldSources?.[key] ?? []).map(index => <a href={r.sources[index].url} target="_blank" rel="noreferrer" aria-label={`${label}来源：${r.sources[index].label}`}>[{index + 1}]</a>)}</span></dd></div>)}</dl>
  <details class="qtl-record-details" open={r.group === 'directories'}>
    <summary><span>{r.detailSections?.length ? '完整说明：数据构成、方法、结果与下载' : '测序、下载与来源'}</span><span class="qtl-detail-hint">展开查看</span></summary>
    <div class="qtl-detail-body">
      <dl class="qtl-fields method-fields">{fields.slice(2).map(([key, label, value]) => <div><dt>{label}</dt><dd>{value}<span class="qtl-cites">{(r.fieldSources?.[key] ?? []).map(index => <a href={r.sources[index].url} target="_blank" rel="noreferrer" aria-label={`${label}来源：${r.sources[index].label}`}>[{index + 1}]</a>)}</span></dd></div>)}</dl>
      <p class="qtl-access"><strong>数据获取</strong>{r.access}</p>
      {r.detailSections?.map((section, index) => <section class="resource-detail-section" aria-labelledby={`${r.id}-detail-${index}`}>
        <h4 id={`${r.id}-detail-${index}`}>{section.title}</h4>
        {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
        {section.table && <div class="resource-table-scroll" role="region" aria-label={`${section.title}数据表`} tabindex="0">
          <table>
            <thead><tr>{section.table.headers.map(header => <th scope="col">{header}</th>)}</tr></thead>
            <tbody>{section.table.rows.map(row => <tr>{row.map((cell, column) => column === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
          </table>
        </div>}
        {section.figure && <figure class="resource-figure">
          <a href={section.figure.src} target="_blank" rel="noreferrer" aria-label={`${section.figure.alt}，查看原图`}><img src={section.figure.src} alt={section.figure.alt} width={section.figure.width} height={section.figure.height} loading="lazy" decoding="async" /></a>
          <figcaption>{section.figure.caption} <a href={section.figure.sourceUrl} target="_blank" rel="noreferrer">原论文</a> · <a href={section.figure.src} target="_blank" rel="noreferrer">查看原图</a></figcaption>
        </figure>}
        {section.sourceIndices?.length && <p class="resource-detail-sources">来源：{section.sourceIndices.map(index => <a href={r.sources[index].url} target="_blank" rel="noreferrer">[{index + 1}] {r.sources[index].label}</a>)}</p>}
      </section>)}
      <div class="qtl-provenance"><p><strong>使用注意</strong> {r.limitations}</p><ol>{r.sources.map(source => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}<span class="sr-only">（新窗口）</span></a></li>)}</ol></div>
    </div>
  </details>
</article>
<style>
  .qtl-resource { min-width: 0; padding: 24px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); scroll-margin-top: 24px; overflow-wrap: anywhere; }
  .qtl-resource:target { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .qtl-meta { display: flex; flex-wrap: wrap; gap: 4px 18px; color: var(--muted); font-size: .875rem; }
  h3 { margin: 7px 0; font-size: 1.25rem; line-height: 1.5; }
  .qtl-title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  .qtl-data-link { flex-shrink: 0; font-size: .875rem; color: var(--accent); text-decoration: none; }
  .qtl-tissue { margin: 0 0 12px; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .qtl-ancestry { margin: 0 0 14px; font-size: 1rem; line-height: 1.8; }
  .qtl-ancestry strong { color: var(--accent); font-size: .875rem; margin-right: 6px; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; }
  .qtl-types { display: flex; flex-wrap: wrap; gap: 6px; }
  .qtl-types span { font-size: .875rem; background: var(--pale); color: var(--accent); padding: 2px 8px; border-radius: 4px; }
  .qtl-summary { margin: 12px 0 18px; font-size: 1rem; color: var(--text); }
  .qtl-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 24px; margin: 0; padding-block: 17px; border-top: 1px solid var(--line); }
  dt { color: var(--muted); font-size: .875rem; margin-bottom: 5px; }
  dd { margin: 0; font-size: 1rem; line-height: 1.8; }
  .qtl-access { margin: 16px 0; font-size: 1rem; }
  .qtl-access strong { display: block; font-size: .875rem; margin-bottom: 5px; }
  .qtl-provenance { font-size: .875rem; color: var(--muted); }
  .qtl-record-details { border-top: 1px solid var(--line); }
  summary { cursor: pointer; color: var(--accent); padding: 12px 0 0; font-weight: 600; font-size: .875rem; }
  .qtl-detail-hint { float: right; color: var(--muted); font-weight: 400; }
  details[open] .qtl-detail-hint { display: none; }
  .qtl-detail-body { padding-top: 12px; }
  .method-fields { border-top: 0; padding-top: 5px; }
  .qtl-provenance p { line-height: 1.85; margin: 12px 0; }
  .qtl-provenance ol { padding-left: 1.3em; margin-bottom: 0; }
  .qtl-provenance a { color: var(--accent); }
  .qtl-cites { display: inline-flex; gap: 5px; margin-left: 6px; font-size: .875rem; vertical-align: baseline; }
  .qtl-cites a { color: var(--accent); text-decoration: none; }
  .qtl-cites a:hover { text-decoration: underline; }
  .resource-detail-section { border-top: 1px solid var(--line); margin-top: 24px; padding-top: 18px; }
  .resource-detail-section h4 { font-size: 1.125rem; line-height: 1.6; color: var(--ink); margin: 0 0 12px; }
  .resource-detail-section p { font-size: 1rem; line-height: 1.85; margin: 12px 0; }
  .resource-table-scroll { overflow-x: auto; margin: 16px 0; }
  .resource-table-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .resource-table-scroll table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: .9375rem; line-height: 1.75; }
  .resource-table-scroll th, .resource-table-scroll td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .resource-table-scroll thead th { background: var(--pale); color: var(--ink); }
  .resource-table-scroll tbody th { min-width: 110px; font-weight: 600; }
  .resource-detail-section .resource-detail-sources { font-size: .875rem; color: var(--muted); }
  .resource-detail-sources a { display: inline-block; margin-right: 12px; color: var(--accent); }
  .resource-figure { margin: 20px 0; }
  .resource-figure img { display: block; max-width: 100%; width: 100%; height: auto; background: white; }
  .resource-figure figcaption { margin-top: 10px; font-size: .875rem; line-height: 1.8; color: var(--muted); }
  .resource-figure figcaption a { color: var(--accent); }
  .qtl-provenance li { padding-block: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 1000px) { .qtl-resource { scroll-margin-top: 76px; } }
  @media (max-width: 700px) { .qtl-resource { padding: 19px 18px; } .qtl-fields { grid-template-columns: 1fr; gap: 16px; } .qtl-title-row { flex-wrap: wrap; gap: 0 12px; margin-bottom: 8px; } }
  @media print { .qtl-resource { break-inside: avoid; } }
</style>
