---
import Base from '../layouts/Base.astro';
import { publishedIssues, iso } from '../lib/issues';
const issues = await publishedIssues();
---
<Base title="归档 · Genetic Daily Papers">
  <header class="page-heading"><div class="eyebrow">Archive</div><h1>日报归档</h1></header>
  <section class="archive-list">
    {issues.map(e => <a class="archive-row" href={`/daily/${e.id}/`}><time datetime={iso(e.data.date)}>{iso(e.data.date)}</time><div><h2>{e.data.title}</h2><p>{e.data.summary}</p></div><span>{e.data.papers.length} 篇 →</span></a>)}
  </section>
</Base>
