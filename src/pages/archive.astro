---
import Base from '../layouts/Base.astro';
import {catalog,formatDate} from '../lib/catalog';
const {issues}=await catalog();
---
<Base title="历史归档 · Genetic Daily Papers"><header class="page-head"><span class="eyebrow">Archive</span><h1>历史归档</h1></header><div class="archive-grid">{issues.map(e=><a class="archive-card" href={`/daily/${e.id}/`}><time datetime={e.id}>{formatDate(e.data.date)}</time><h2>{e.data.title}</h2><p>{e.data.summary}</p><span class="archive-count">{e.data.papers.length} 篇论文与资源 →</span></a>)}</div></Base>
