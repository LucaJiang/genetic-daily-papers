---
import Base from '../../layouts/Base.astro';
import PriorityBadge from '../../components/PriorityBadge.astro';
import { render } from 'astro:content';
import { publishedIssues, publishedPapers, iso } from '../../lib/issues';
import { topicLabel } from '../../data/topics';

export async function getStaticPaths() {
  return (await publishedPapers()).map(paper => ({ params: { id: paper.id }, props: { paper } }));
}

const { paper } = Astro.props;
const { Content, headings } = await render(paper);
const issues = await publishedIssues();
const issue = issues.find(d => d.data.papers.includes(paper.id));
const toc = headings.filter(h => h.depth === 2);
---
<Base title={`${paper.data.shortTitle ?? paper.data.title} · Genetic Daily Papers`} description={paper.data.summary}>
  <div class="article-layout">
    <article class="review-article">
      {issue && <a class="back" href={`/daily/${issue.id}/`}>← {iso(issue.data.date)} 日报</a>}
      <header class="article-header">
        <div class="paper-meta"><span class="journal">{paper.data.source}</span><time datetime={iso(paper.data.date)}>{iso(paper.data.date)}</time>{paper.data.versionDate && <span>{paper.data.version} 更新 <time datetime={iso(paper.data.versionDate)}>{iso(paper.data.versionDate)}</time></span>}<PriorityBadge priority={paper.data.priority}/></div>
        <h1>{paper.data.shortTitle ?? paper.data.title}</h1>
        {paper.data.shortTitle && <p class="original-title">{paper.data.title}</p>}
        <p class="authors">{paper.data.authors}</p>
        <div class="article-actions">
          <a href={paper.data.paperUrl} target="_blank" rel="noreferrer">论文原文 ↗</a>
          {paper.data.pdfUrl && <a href={paper.data.pdfUrl} target="_blank" rel="noreferrer">PDF ↗</a>}
          {paper.data.codeUrl && <a href={paper.data.codeUrl} target="_blank" rel="noreferrer">代码 ↗</a>}
          {paper.data.resourceUrl && <a href={paper.data.resourceUrl} target="_blank" rel="noreferrer">数据资源 ↗</a>}
          <span>{paper.data.peerReviewed ? (paper.data.version ?? '已同行评议') : `预印本${paper.data.version ? ` · ${paper.data.version}` : ''}`}</span>
        </div>
        <p class="article-lead">{paper.data.summary}</p>
      </header>
      <details class="mobile-toc"><summary>本文目录</summary><nav aria-label="本文目录">{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>
      <div class="prose"><Content/></div>
      <footer class="article-footer">
        <div class="tags">{paper.data.topics.map(t => <a href={`/topics/${t}/`}>{topicLabel(t)}</a>)}</div>
        {paper.data.doi && <p>DOI <a href={`https://doi.org/${paper.data.doi}`} target="_blank" rel="noreferrer">{paper.data.doi}</a></p>}
      </footer>
    </article>
    <aside class="toc"><span>本文目录</span><nav>{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>
  </div>
</Base>
