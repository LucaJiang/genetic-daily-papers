---
import Base from '../../layouts/Base.astro';
import FigureGallery from '../../components/FigureGallery.astro';
import { render } from 'astro:content';
import { catalog, isoDate } from '../../lib/catalog';
import { figuresForPaper } from '../../lib/figures';
import { topicLabel } from '../../data/topics';
export async function getStaticPaths(){const {papers}=await catalog();return papers.map(paper=>({params:{id:paper.id},props:{paper}}));}
const {paper}=Astro.props; const p=paper.data; const {Content,headings}=await render(paper);
const {issues}=await catalog(); const issue=issues.find(e=>e.data.papers.includes(paper.id));
const figures=figuresForPaper(paper); const toc=headings.filter(h=>h.depth===2);
---
<Base title={`${p.shortTitle??p.title} · Genetic Daily Papers`} description={p.summary}>
{issue && <a class="back-link" href={`/daily/${issue.id}/`}>← {issue.id} 日报</a>}
<header class="article-header"><div class="card-meta"><span class="journal">{p.source}</span><time datetime={isoDate(p.date)}>{isoDate(p.date)}</time>{p.readingType && <span class="reading-type">{p.readingType}</span>}{!p.peerReviewed && <span class="preprint">预印本 · 未经同行评议</span>}</div><h1>{p.shortTitle??p.title}</h1>{p.shortTitle && <p class="original-title">{p.title}</p>}<p class="authors">{p.authors}</p><p class="article-summary">{p.summary}</p><div class="paper-actions"><a class="button primary" href={p.paperUrl} target="_blank" rel="noreferrer">论文原文 ↗</a>{p.codeUrl && <a class="button" href={p.codeUrl} target="_blank" rel="noreferrer">代码 ↗</a>}{p.resourceUrl && <a class="button" href={p.resourceUrl} target="_blank" rel="noreferrer">数据资源 ↗</a>}</div></header>
<div class="article-layout"><nav class="article-toc" aria-label="文章目录"><h2>本文内容</h2>{toc.map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav><div class="article-main"><article class="paper-article"><Content/></article>{!p.inlineFigures && <FigureGallery id="figures" title="实证结果与方法图" figures={figures}/>}<footer class="article-footer"><span>{p.source} · 发表于 {isoDate(p.date)}{p.version?` · ${p.version}`:''}</span>{p.doi && <p>DOI: <a href={`https://doi.org/${p.doi}`}>{p.doi}</a></p>}<div class="tags">{p.topics.map((t:string)=><a class="tag" href={`/topics/${t}/`}>{topicLabel(t)}</a>)}</div></footer></div></div>
</Base>
