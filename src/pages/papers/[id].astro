---
import Base from '../../layouts/Base.astro';
import PriorityBadge from '../../components/PriorityBadge.astro';
import { getCollection, render } from 'astro:content';
import { topicLabel } from '../../data/topics';

export async function getStaticPaths() {
  const papers = await getCollection('papers');
  return papers.map((paper) => ({ params: { id: paper.id }, props: { paper } }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
const issues = await getCollection('daily');
const issue = issues.find((entry) => entry.data.papers.includes(paper.id));
const date = paper.data.date.toISOString().slice(0, 10);
---
<Base title={`${paper.data.shortTitle ?? paper.data.title} · Genetic Daily Papers`} description={paper.data.summary}>
  {issue && <a class="back-link" href={`/daily/${issue.id}/`}>← 返回 {issue.data.date.toISOString().slice(0, 10)} 日报</a>}

  <header class="paper-hero">
    <div class="paper-hero__topline">
      <PriorityBadge priority={paper.data.priority} />
      <span>{paper.data.source}</span><span>·</span><time datetime={date}>{date}</time>
      {paper.data.version && <><span>·</span><span>{paper.data.version}</span></>}
      <span>·</span><span>{paper.data.peerReviewed ? '同行评议论文' : '预印本，尚未完成期刊同行评议'}</span>
    </div>
    <h1>{paper.data.title}</h1>
    <p class="paper-hero__authors">{paper.data.authors}</p>
    <p class="paper-hero__summary"><strong>一句话结论：</strong>{paper.data.summary}</p>
    <div class="paper-actions">
      <a class="button button--primary" href={paper.data.paperUrl} target="_blank" rel="noreferrer">原文 ↗</a>
      {paper.data.codeUrl && <a class="button" href={paper.data.codeUrl} target="_blank" rel="noreferrer">代码 ↗</a>}
      {paper.data.doi && <a class="button" href={`https://doi.org/${paper.data.doi}`} target="_blank" rel="noreferrer">DOI ↗</a>}
    </div>
  </header>

  {paper.data.figure && (
    <figure class="paper-figure">
      <a href={paper.data.figure.sourceUrl} target="_blank" rel="noreferrer">
        <img src={paper.data.figure.url} alt={paper.data.figure.alt} loading="lazy" referrerpolicy="no-referrer" />
      </a>
      <figcaption>
        {paper.data.figure.caption} 图源：{paper.data.figure.credit}。
        {paper.data.figure.license && <>许可：{paper.data.figure.license}。</>}
        <a href={paper.data.figure.sourceUrl} target="_blank" rel="noreferrer">查看原图 ↗</a>
      </figcaption>
    </figure>
  )}

  <div class="paper-layout">
    <article class="paper-body"><Content /></article>
    <aside class="paper-aside">
      <section class="aside-card">
        <h2>Why it matters</h2>
        <p>{paper.data.whyItMatters}</p>
      </section>
      <section class="aside-card">
        <h2>Research areas</h2>
        <div class="tag-list">
          {paper.data.topics.map((topic: string) => <a class="tag" href={`/topics/${topic}/`}>{topicLabel(topic)}</a>)}
        </div>
      </section>
      <section class="aside-card">
        <h2>Bibliography</h2>
        <dl>
          <dt>发布日期</dt><dd>{date}</dd>
          <dt>来源</dt><dd>{paper.data.source}{paper.data.version ? ` · ${paper.data.version}` : ''}</dd>
          {paper.data.doi && <><dt>DOI</dt><dd>{paper.data.doi}</dd></>}
          <dt>审稿状态</dt><dd>{paper.data.peerReviewed ? '已同行评议' : '预印本'}</dd>
        </dl>
      </section>
    </aside>
  </div>
</Base>
