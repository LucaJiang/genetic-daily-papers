---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { topics } from '../data/topics';
const papers = await getCollection('papers');
const count = (slug: string) => papers.filter((paper) => paper.data.topics.includes(slug)).length;
---
<Base title="Topics · Genetic Daily Papers">
  <section class="hero">
    <div class="eyebrow">Browse by research area</div>
    <h1>按研究主题浏览</h1>
    <p>主题页会自动聚合所有相关论文。每个分类现在都可以进入，并随着日报积累持续更新。</p>
  </section>
  <div class="topic-grid">
    {topics.map((topic) => (
      <a class="topic-card" href={`/topics/${topic.slug}/`}>
        <span class="topic-card__count">{count(topic.slug)} PAPERS</span>
        <h2>{topic.label}</h2>
        <p>{topic.description}</p>
        <div class="topic-card__footer"><span>查看专题</span><span>→</span></div>
      </a>
    ))}
  </div>
</Base>
