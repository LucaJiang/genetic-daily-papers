---
import Base from '../layouts/Base.astro';
import {topics} from '../data/topics';
import {publishedPapers} from '../lib/issues';
const papers=await publishedPapers();
---
<Base title="研究主题 · Genetic Daily Papers"><header class="page-heading"><div class="eyebrow">Research areas</div><h1>研究主题</h1></header><section class="topic-grid">{topics.map(t=><a class="topic-card" href={`/topics/${t.slug}/`}><span class="topic-count">{papers.filter(p=>p.data.topics.includes(t.slug)).length} 篇</span><h2>{t.label}</h2><p>{t.description}</p><span aria-hidden="true">↗</span></a>)}</section></Base>
