---
import Base from '../../layouts/Base.astro';
import PaperCard from '../../components/PaperCard.astro';
import { render } from 'astro:content';
import { catalog, formatDate } from '../../lib/catalog';
export async function getStaticPaths(){ const {issues}=await catalog(); return issues.map(entry=>({params:{id:entry.id},props:{entry}})); }
const {entry}=Astro.props; const {resolve}=await catalog(); const papers=resolve(entry); const {Content}=await render(entry);
---
<Base title={`${entry.data.title} · Genetic Daily Papers`} description={entry.data.summary}>
<a class="back-link" href="/archive/">← 历史归档</a>
<header class="page-head"><span class="eyebrow">Daily Paper Radar</span><h1>{formatDate(entry.data.date)}</h1><p>{entry.data.summary}</p><div class="issue-meta"><span>{papers.length} 篇论文与资源</span><span>文章发布日期见各条目</span></div></header>
<div class="paper-list">{papers.map(p=><PaperCard paper={p}/>)}</div>
{entry.body?.trim() && <section class="daily-note"><Content/></section>}
</Base>
