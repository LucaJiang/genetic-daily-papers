---
import Base from '../../layouts/Base.astro';
import PaperCard from '../../components/PaperCard.astro';
import ResourceBrief from '../../components/ResourceBrief.astro';
import { render } from 'astro:content';
import { publishedIssues, publishedPapers, resolvePapers, iso, dateLabel } from '../../lib/issues';

export async function getStaticPaths() {
  return (await publishedIssues()).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const papers = resolvePapers(entry, await publishedPapers());
const { Content } = await render(entry);
---
<Base title={`${iso(entry.data.date)} · Genetic Daily Papers`} description={entry.data.summary}>
  <a class="back" href="/archive/">← 日报归档</a>
  <header class="issue-header">
    <div class="eyebrow"><time datetime={iso(entry.data.date)}>{dateLabel(entry.data.date)}</time><span>{papers.length} 篇论文{entry.data.briefs.length ? ` · ${entry.data.briefs.length} 项资源` : ''}</span></div>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
  </header>
  <div class="section-bar"><h2>本期论文</h2><span>论文日期见各条目</span></div>
  <section class="paper-list" aria-label="本期论文">{papers.map((p,i) => <PaperCard paper={p} index={i + 1}/>)}</section>
  {entry.data.briefs.length > 0 && <section class="briefs"><div class="section-bar"><h2>数据资源</h2></div>{entry.data.briefs.map(b => <ResourceBrief brief={b}/>)}</section>}
  {entry.body?.trim() && <section class="daily-notes prose"><Content/></section>}
</Base>
