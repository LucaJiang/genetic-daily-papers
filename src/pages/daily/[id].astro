---
import Base from '../../layouts/Base.astro';
import PaperCard from '../../components/PaperCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('daily');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allPapers = await getCollection('papers');
const paperById = new Map(allPapers.map((paper) => [paper.id, paper]));
const missing = entry.data.papers.filter((id: string) => !paperById.has(id));
if (missing.length > 0) {
  throw new Error(`Daily issue ${entry.id} references missing paper pages: ${missing.join(', ')}`);
}
const papers = entry.data.papers.map((id: string) => paperById.get(id)!);
const date = entry.data.date.toISOString().slice(0, 10);
const formatDate = (value: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(value);
---
<Base title={`${entry.data.title} · Genetic Daily Papers`} description={entry.data.summary}>
  <a class="back-link" href="/archive/">← 历史日报</a>

  <header class="daily-header">
    <div class="daily-header__date"><time datetime={date}>{formatDate(entry.data.date)}</time></div>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
    <div class="daily-header__count"><strong>{papers.length}</strong><span>篇论文</span></div>
  </header>

  <section class="daily-paper-section" aria-labelledby="daily-paper-title">
    <div class="daily-section-title">
      <h2 id="daily-paper-title">本期论文</h2>
      <span>{papers.length}</span>
    </div>
    <div class="paper-entry-list">
      {papers.map((paper, index) => <PaperCard paper={paper} index={index + 1} total={papers.length} />)}
    </div>
  </section>

  <section class="daily-note"><Content /></section>
</Base>
