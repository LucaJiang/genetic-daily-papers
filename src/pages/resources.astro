---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import {catalog} from '../lib/catalog';
const {papers}=await catalog();
const resources=papers.filter(p=>p.data.kind==='resource'||p.id==='omicspred');
const releases=[
 {date:'2026-05-28',title:'GTEx V11 bulk RNA-seq',body:'成人组织表达与 QTL 数据的新版本；各文件的基因注释、数据版本和分析说明以 GTEx 下载页为准。',href:'https://gtexportal.org/home/downloads/adult-gtex/overview'},
 {date:'2026-05-05',title:'Developmental GTEx V1 / NHP-dGTEx V1',body:'人类与非人灵长类发育组织数据的首次发布。',href:'https://gtexportal.org/'}
];
---
<Base title="数据资源 · Genetic Daily Papers"><header class="page-head"><span class="eyebrow">Data resources</span><h1>数据资源</h1><p>遗传参考面板、分子 QTL 图谱与新发表的数据库论文。</p></header><div class="paper-list">{resources.map(p=><PaperCard paper={p}/>)}</div><div class="section-head"><h2>既往数据发布</h2></div>{releases.map(r=><article class="release-card"><time datetime={r.date}>{r.date}</time><div><h2>{r.title}</h2><p>{r.body}</p><a href={r.href} target="_blank" rel="noreferrer">官方数据与版本说明 ↗</a></div></article>)}</Base>
