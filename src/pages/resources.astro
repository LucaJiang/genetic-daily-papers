---
import Base from '../layouts/Base.astro';
import ResourceBrief from '../components/ResourceBrief.astro';
import PaperCard from '../components/PaperCard.astro';
import {publishedIssues,publishedPapers} from '../lib/issues';
const issues=await publishedIssues(),seen=new Set<string>();
const briefs=issues.flatMap(i=>i.data.briefs).filter(b=>{if(seen.has(b.id))return false;seen.add(b.id);return true;}).sort((a,b)=>+b.date-+a.date);
const previous=issues.filter(i=>i.data.topics.includes('resources')&&!i.data.briefs.length);
const papers=(await publishedPapers()).filter(p=>p.data.topics.includes('resources')).sort((a,b)=>+b.data.date-+a.data.date);
---
<Base title="数据资源 · Genetic Daily Papers"><header class="page-heading"><div class="eyebrow">Data releases</div><h1>数据资源</h1><p>新数据、数据库论文与队列发布。</p></header>{briefs.map(b=><ResourceBrief brief={b}/>)}<div class="section-bar"><h2>数据库论文</h2></div><section class="paper-list">{papers.map((p,i)=><PaperCard paper={p} index={i+1}/>)}</section>{previous.length>0&&<section class="recent"><div class="section-bar"><h2>往期数据记录</h2></div>{previous.map(e=><a class="archive-row" href={`/daily/${e.id}/`}><time>{e.id}</time><strong>{e.data.title}</strong><span>查看 →</span></a>)}</section>}<p class="resource-directory">常用入口：<a href="https://gtexportal.org/">GTEx</a> · <a href="https://www.ebi.ac.uk/eqtl/">eQTL Catalogue</a> · <a href="https://yanglab.westlake.edu.cn/smr-portal/">SMR Portal</a></p></Base>
