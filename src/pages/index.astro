---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import { getCollection } from 'astro:content';

const issues = (await getCollection('daily'))
  .filter((entry) => entry.data.papers.length > 0)
  .sort((a, b) => +b.data.date - +a.data.date);
const allPapers = await getCollection('papers');
const latest = issues[0];
const papers = latest ? latest.data.papers.map((id) => allPapers.find((paper) => paper.id === id)).filter(Boolean) : [];
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(date);
---
<Base>
  <section class="hero hero--v4">
    <div class="eyebrow">Daily Paper Radar</div>
    <h1>今日论文</h1>
    <p>统计遗传学、单细胞与空间组学、QTL、fine-mapping、调控模型和算法加速。</p>
    {latest && <div class="hero__meta"><span>{formatDate(latest.data.date)}</span><span>{papers.length} 篇</span></div>}
  </section>

  {latest ? (
    <>
      <section class="issue-intro issue-intro--v4">
        <div><div class="eyebrow">Latest</div><h2>{latest.data.title}</h2><p>{latest.data.summary}</p></div>
        <a class="button" href={`/daily/${latest.id}/`}>查看日报</a>
      </section>
      <section class="section">
        <div class="paper-list">{papers.map((paper, index) => paper && <PaperCard paper={paper} featured={index === 0} />)}</div>
      </section>
    </>
  ) : <section class="empty-state"><h2>尚未发布日报</h2></section>}
</Base>
