---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import { getCollection } from 'astro:content';

const issues = (await getCollection('daily')).sort((a, b) => +b.data.date - +a.data.date);
const allPapers = await getCollection('papers');
const latest = issues[0];
const papers = latest
  ? latest.data.papers.map((id) => allPapers.find((paper) => paper.id === id)).filter(Boolean)
  : [];
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(date);
---
<Base>
  <section class="hero">
    <div class="eyebrow">Daily Paper Radar</div>
    <h1>不是论文列表，而是方法学筛选。</h1>
    <p>聚焦统计遗传学、单细胞计算方法、QTL 与 fine-mapping、调控模型，以及从算子和系统瓶颈出发的算法加速。</p>
    {latest && <div class="hero__meta"><span>{formatDate(latest.data.date)}</span><span>{papers.length} 篇重点解读</span><span>每日更新</span></div>}
  </section>

  {latest ? (
    <>
      <section class="issue-intro">
        <div class="eyebrow">Latest Issue</div>
        <h2>{latest.data.title}</h2>
        <p>{latest.data.summary}</p>
        <a class="text-link" href={`/daily/${latest.id}/`}>查看当日完整摘要与资源更新 →</a>
      </section>

      <section class="section">
        <div class="section-heading">
          <div><h2>今日精选</h2><p>Daily 页保留摘要；每篇论文进入独立的技术精读页。</p></div>
          <a href={`/daily/${latest.id}/`}>当日目录 →</a>
        </div>
        <div class="paper-list">
          {papers.map((paper, index) => paper && <PaperCard paper={paper} featured={index === 0} />)}
        </div>
      </section>
    </>
  ) : (
    <section class="empty-state"><h2>尚未发布日报</h2><p>第一期 Paper Radar 将显示在这里。</p></section>
  )}
</Base>
