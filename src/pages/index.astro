---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import { catalog, formatDate } from '../lib/catalog';
import { topicLabel } from '../data/topics';
const {issues,resolve}=await catalog(); const latest=issues[0]; const papers=latest?resolve(latest):[];
const core=['QTL','fine-mapping','single-cell','functional-annotation','statistical-genetics','algorithm-acceleration'];
---
<Base>
<header class="page-head"><div class="top-row"><span class="eyebrow">Daily Paper Radar</span><a href="/archive/">历史归档 →</a></div><h1>遗传统计与细胞组学</h1><p>GWAS · 分子 QTL · Fine-mapping · 性状相关细胞 · 调控机制</p></header>
<div class="topic-strip">{core.map(t=><a class="tag" href={`/topics/${t}/`}>{topicLabel(t)}</a>)}</div>
{latest ? <><div class="section-head"><h2>{formatDate(latest.data.date)}</h2><a href={`/daily/${latest.id}/`}>{papers.length} 篇 · 查看本期 →</a></div><p class="latest-summary">{latest.data.summary}</p><div class="paper-list">{papers.map(p=><PaperCard paper={p}/>)}</div></> : <p class="empty-state">暂无已发布日报。</p>}
</Base>
