---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import ResourceBrief from '../components/ResourceBrief.astro';
import {publishedIssues,publishedPapers,resolvePapers,iso,dateLabel} from '../lib/issues';
const issues=await publishedIssues(),latest=issues[0],all=await publishedPapers();
const papers=latest?resolvePapers(latest,all):[];
---
<Base>
{latest?<><header class="issue-header"><div class="eyebrow"><span>最新一期</span><time datetime={iso(latest.data.date)}>{dateLabel(latest.data.date)}</time><span>{papers.length} 篇论文{latest.data.briefs.length?` · ${latest.data.briefs.length} 项资源`:''}</span></div><h1>{latest.data.title}</h1><p>{latest.data.summary}</p></header><div class="section-bar"><h2>论文精选</h2><a href={`/daily/${latest.id}/`}>本期链接 ↗</a></div><section class="paper-list" aria-label="论文精选">{papers.map((p,i)=><PaperCard paper={p} index={i+1}/>)}</section>{latest.data.briefs.length>0&&<section class="briefs"><div class="section-bar"><h2>数据资源</h2></div>{latest.data.briefs.map(b=><ResourceBrief brief={b}/>)}</section>}<section class="recent"><div class="section-bar"><h2>往期</h2><a href="/archive/">全部归档 ↗</a></div>{issues.slice(1,4).map(e=><a class="archive-row" href={`/daily/${e.id}/`}><time>{iso(e.data.date)}</time><strong>{e.data.title}</strong><span>{e.data.papers.length} 篇 →</span></a>)}</section></>:<header class="issue-header"><h1>暂无已发布日报</h1></header>}
</Base>
