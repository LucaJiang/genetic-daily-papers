---
import Base from '../../layouts/Base.astro';
import PaperCard from '../../components/PaperCard.astro';
import { getCollection } from 'astro:content';
import { topics } from '../../data/topics';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const papers = (await getCollection('papers')).filter((paper) => paper.data.topics.includes(topic.slug)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title={`${topic.label} · Genetic Daily Papers`} description={topic.description}>
  <a class="back-link" href="/topics/">← Topics</a>
  <section class="hero hero--v4"><div class="eyebrow">Research area</div><h1>{topic.label}</h1><p>{topic.description}</p><div class="hero__meta"><span>{papers.length} 篇</span></div></section>
  {papers.length ? <div class="paper-list">{papers.map((paper, index) => <PaperCard paper={paper} featured={index === 0} />)}</div> : <section class="empty-state"><h2>暂未收录</h2></section>}
</Base>
