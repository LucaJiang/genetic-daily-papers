---
import Base from '../../layouts/Base.astro';
import PaperCard from '../../components/PaperCard.astro';
import {catalog} from '../../lib/catalog';
import {topics} from '../../data/topics';
export function getStaticPaths(){return topics.map(topic=>({params:{topic:topic.slug},props:{topic}}));}
const {topic}=Astro.props; const {papers:all}=await catalog();const papers=all.filter(p=>p.data.topics.includes(topic.slug));
---
<Base title={`${topic.label} · Genetic Daily Papers`}><a class="back-link" href="/topics/">← 全部主题</a><header class="page-head"><span class="eyebrow">Research area</span><h1>{topic.label}</h1><p>{topic.description}</p><div class="issue-meta">{papers.length} 篇论文与资源</div></header>{papers.length?<div class="paper-list">{papers.map(p=><PaperCard paper={p}/>)}</div>:<p class="empty-state">该主题暂无已收录论文。</p>}</Base>
