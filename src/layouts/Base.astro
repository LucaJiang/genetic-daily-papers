---
import '../styles/global.css';
import '../styles/v5.css';
import '../styles/v6.css';
import 'katex/dist/katex.min.css';

const {
  title = 'Genetic Daily Papers',
  description = '统计遗传学、单细胞与空间组学、QTL、调控模型和算法加速的每日论文解读。',
} = Astro.props;

const path = Astro.url.pathname;
const navItems = [
  ['/', 'Today'],
  ['/archive/', 'Archive'],
  ['/topics/', 'Topics'],
  ['/resources/', 'Data releases'],
];
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f3ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="wrap site-header__inner">
          <a class="brand" href="/" aria-label="Genetic Daily Papers 首页">
            <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span>
              <strong>Genetic Daily Papers</strong>
              <small>STATISTICS · GENETICS · SINGLE-CELL</small>
            </span>
          </a>
          <nav class="main-nav" aria-label="主导航">
            {navItems.map(([href, label]) => (
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
        </div>
      </header>
      <main class="wrap main-content"><slot /></main>
      <footer class="site-footer">
        <div class="wrap site-footer__inner">
          <span>Genetic Daily Papers</span>
          <span><a href="/rss.xml">RSS</a> · <a href="https://github.com/LucaJiang/genetic-daily-papers">GitHub</a></span>
        </div>
      </footer>
    </div>
  </body>
</html>
